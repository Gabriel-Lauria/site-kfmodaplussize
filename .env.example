# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables). Sem as do Supabase, o site usa os dados de config/
# e o painel /admin mostra como configurar.

# Endereço do site em produção (links do sitemap, Open Graph e dados estruturados)
NEXT_PUBLIC_SITE_URL=https://kfmodaplussize.vercel.app

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública: "publishable key" (sb_publishable_...) ou a "anon key" dos projetos antigos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# chave secreta: "secret key" (sb_secret_...) ou a "service_role key" dos projetos antigos.
# NUNCA use NEXT_PUBLIC_ nesta. Só o servidor a usa, para gravar avaliações enviadas pelo site.
SUPABASE_SECRET_KEY=

# Opcional: texto aleatório usado para embaralhar o IP no limite de avaliações (padrão: a chave secreta)
REVIEW_IP_SALT=

# Segredo do cron diário que mantém o Supabase gratuito ativo (vercel.json → /api/keepalive).
# Gere um texto aleatório longo; a Vercel envia esse valor automaticamente ao chamar o cron.
CRON_SECRET=
